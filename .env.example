# 模型接口中转站基础地址（换站只需改这一处，路径 /v1、/v1beta 自动拼接）
VITE_MODEL_API_BASE=https://lixuejianapi.xyz
# 视频生成接口基础地址（可选，不填则用 ${VITE_MODEL_API_BASE}/api/v3）
# VITE_VIDEO_API_BASE=
# 视频生成模型（可选，默认 doubao-seedance-2-5-260628）
# VITE_VIDEO_MODEL=

# 前端 API 地址（本地开发用 localhost，生产环境改为实际后端地址）
VITE_API_BASE_URL=http://localhost:3001/api

# 服务端允许的客户端域名（多个用逗号分隔）
CLIENT_URL=https://midnightatelier.netlify.app

# 阿里云 OSS 配置
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
# 可选：自定义域名（如 CDN 域名），不填则使用默认 OSS 域名
# OSS_PUBLIC_URL=https://cdn.yourdomain.com

